# Postgres — Neon, Supabase, or Railway all work
DATABASE_URL="postgresql://user:pass@host:5432/hookedonphotonics"

# 32-byte random string; generate with: openssl rand -hex 32
SESSION_SECRET="replace-me-with-64-hex-characters-at-least-32-bytes"

# Pepper added before hashing emails; rotate carefully (invalidates all logins).
EMAIL_PEPPER="another-long-random-string"

# Resend API key for magic-link emails. Leave blank in dev — codes print to server console.
RESEND_API_KEY=""
EMAIL_FROM="Hooked on Photonics <noreply@hookedonphotonics.example>"

# Public base URL, used in magic-link emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"
